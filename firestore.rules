rules_version = '2';

// Firestore security rules for Stone Town Heritage VT-Guide.
//
// Model:
//   - sites:      world-readable, admin-writable.
//   - activities: world-readable, admin-writable (audit log surfaced in
//                 the admin analytics screen).
//   - users:      each user can read/write their own profile; admins can
//                 read all users (needed for the Admin User Management
//                 screen) and delete any user.
//   - roles:      the canonical role store. Each user has one document at
//                 roles/{uid} with `{ role: 'free' | 'premium' | 'admin',
//                 updated_at }`. New users default to `free`; only an
//                 existing admin can write here.
//   - everything else: default-deny.
//
// Deploy with `firebase deploy --only firestore` or via the
// Firebase console editor. The `isAdmin()` helper reads the caller's
// roles/{uid} doc on every admin-gated request — fine for demo traffic,
// production should switch to custom claims via Cloud Functions.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from an admin? Reads the user's role doc.
    // Includes a legacy fallback to users/{uid} for admins created before Phase 3.
    function isAdmin() {
      return request.auth != null
          && (
            (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
             && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin')
            ||
            (exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
          );
    }

    // sites: world-readable, admin-writable.
    match /sites/{siteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // activities: world-readable, admin-writable. Same shape as sites so
    // the admin analytics screen can fetch the feed without auth, while
    // admins remain the only ones who can append events.
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // users/{uid}: owner read/write; admin can read/delete any user.
    match /users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());
      // Prevent users from elevating themselves via the legacy role field.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (!request.resource.data.keys().hasAny(['role']) 
                       || (resource != null && request.resource.data.role == resource.data.role));
      allow delete: if request.auth != null
                    && (request.auth.uid == userId || isAdmin());
    }

    // roles/{uid}: only writable by an existing admin.
    // Reads allowed for the owner and admins (so the Admin User
    // Management screen can display every user's role).
    match /roles/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}